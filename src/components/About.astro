---
// 关于我：引言贴纸卡 + 介绍 + 经历 + 技能标签（对应设计稿 2:101）
const experiences = [
  { dot: 'dot-yellow', text: '客户侧：需求洽谈 → 方案演示 → 配置交付 → 使用辅导 → 反馈回收，五环节独立闭环' },
  { dot: 'dot-pink', text: '工程侧：React / Vue3 / TypeScript + Node.js，B 端系统与高并发 C 端活动页交付' },
  { dot: 'dot-green', text: '双向转译：把业务问题拆成 AI 可介入的环节，也把系统能力讲成客户用得上的操作' },
];

const skills = ['Prompt 工程', '智能助手配置', '知识库 / RAG', 'LLM 评测', 'React', 'Vue3', 'TypeScript', 'Node.js', 'Python', 'Docker', 'Claude Code / Cursor', 'GEO'];
---

<section class="about" id="about">
  <div class="section-header">
    <span class="section-tag">ABOUT ME</span>
    <h2 class="section-title">关于我</h2>
  </div>

  <div class="about-row">
    <div class="about-quote-card">
      <span class="quote-mark">“</span>
      <p class="quote-text">方案讲得再漂亮，客户用起来才算落地。</p>
      <p class="quote-by">—— 我做交付的标准</p>
    </div>

    <div class="about-right">
      <p class="about-intro">
        前端全栈开发出身，2 年 8 个月 B 端项目交付打底；近一年转到 AI
        企业服务一线，直面客户洽谈方案、驻场辅导系统落地、以 Prompt 工程交付多场景智能助手。既能和研发对齐实现，也能把技术能力翻译成业务方听得懂的用法——这条双向转译的链路，是我最核心的能力。现在正补齐 RAG / Agent Loop / 评测体系的工程闭环。
      </p>

      {experiences.map((e) => (
        <div class="exp-row">
          <span class={`exp-dot ${e.dot}`}></span>
          <span class="exp-text">{e.text}</span>
        </div>
      ))}

      <p class="skills-title">常用工具箱</p>
      <div class="skills-wrap">
        {skills.map((s) => <span class="skill-chip">{s}</span>)}
      </div>
    </div>
  </div>
</section>
