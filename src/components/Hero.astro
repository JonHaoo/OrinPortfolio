---
// Hero 区：贴纸徽章 + 大标题荧光块 + 双 CTA + 插画卡片（对应设计稿 2:15）
const BASE_URL = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
---

<section class="hero">
  <div class="hero-left">
    <span class="hero-badge">AI 解决方案工程师 / FDE</span>
    <h1 class="hero-title">
      把 AI 真正<br />
      <span class="hero-title-marker">落地到业务里</span>
    </h1>
    <p class="hero-sub">
      从客户需求沟通、方案演示，到智能助手配置交付与使用辅导——我能独立跑通 AI 落地的完整链路。前端企业级项目开发出身，具备扎实的工程能力，从架构设计、数据流梳理到长期迭代维护都能独立扛住，正在补齐 RAG / Agent 评测闭环。
    </p>
    <div class="hero-cta-row">
      <a class="btn btn-primary" href="#works">
        看看我的作品
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 10H17M17 10L11 4M17 10L11 16" stroke="#FFDC58" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <a class="btn btn-secondary" href="#contact">聊聊 AI 落地</a>
    </div>
    <div class="hero-trust">
      <span class="trust-dot"></span>
      <span>2 个智能助手场景已交付 · 完整交付链路可独立闭环</span>
    </div>
  </div>

  <div class="hero-right">
    <!-- 平面模式：贴纸相框卡（默认）；3D 模式：相框退场，canvas 直接置入 hero 背景上 -->
    <div class="hero-image-card" aria-hidden="true">
      <img
        class="hero-avatar-poster"
        src={`${BASE_URL}images/hero-3d.jpg`}
        alt="我的 Q 版 3D 形象平面图：黑刺猬头发、圆框眼镜、手持咖啡"
      />
    </div>
    <div
      class="hero-avatar-canvas"
      data-model={`${BASE_URL}models/avatar.glb`}
      aria-label="我的 Q 版 3D 形象：黑刺猬头发、圆框眼镜、手持咖啡，可拖拽旋转、点击跳跃"
      role="img"
    ></div>
    <button
      class="hero-mode-toggle"
      id="hero-mode-toggle"
      type="button"
      aria-pressed="false"
      title="切换平面图 / 3D 模型"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 6C4 4.9 4.9 4 6 4H16C17.1 4 18 4.9 18 6V16C18 17.1 17.1 18 16 18H6C4.9 18 4 17.1 4 16V6Z" stroke="currentColor" stroke-width="2"/>
        <path d="M20 8V17C20 19.2 18.2 21 16 21H8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <span class="hero-mode-label">3D</span>
    </button>
    <div class="hero-status-badge">开放合作</div>
    <svg class="hero-sparkle" viewBox="0 0 44 44" fill="none" aria-hidden="true">
      <path d="M22 0L27 17L44 22L27 27L22 44L17 27L0 22L17 17L22 0Z" fill="#141414" />
    </svg>
  </div>

<script>
  // Hero 形象切换 + 3D 挂载（软导航纪律：document 级 astro:page-load 驱动，
  // astro:before-swap 时 dispose。module 只执行一次，监听器长存且幂等）
  import { initHeroAvatar } from '../scripts/hero-avatar';

  let instance: ReturnType<typeof initHeroAvatar> | null = null;
  const MODE_KEY = 'hero-mode';

  function applyMode(mode3d: boolean, withPop = false) {
    document.body.classList.toggle('hero-3d-mode', mode3d);
    const btn = document.getElementById('hero-mode-toggle');
    if (btn) btn.setAttribute('aria-pressed', String(mode3d));
    try { localStorage.setItem(MODE_KEY, mode3d ? '3d' : 'flat'); } catch { /* 隐私模式忽略 */ }
    if (mode3d) {
      // 模型加载失败会留下空实例；先销毁，否则再次切换时只加 class、停在空白画布
      if (instance?.getState().loadError) {
        instance.dispose();
        instance = null;
        delete (window as any).__ORIN_AVATAR__;
      }
      if (!instance) {
        const container = document.querySelector<HTMLElement>('.hero-avatar-canvas');
        if (container) {
          try {
            instance = initHeroAvatar(container);
          } catch {
            // WebGL 不可用（老设备 / 浏览器禁用 / 无 GPU）时自动回退平面图：
            // 否则相框已退场、画布又建不起来 → 人物形象整块空白，且刷新后仍是空白
            document.body.classList.remove('hero-3d-mode');
            try { localStorage.setItem(MODE_KEY, 'flat'); } catch { /* 隐私模式忽略 */ }
            const btn = document.getElementById('hero-mode-toggle');
            if (btn) {
              btn.setAttribute('aria-pressed', 'false');
              btn.title = '当前设备不支持 3D，已显示平面图';
            }
            return;
          }
        }
      }
    }
    // 切入 3D 且用户未偏好减少动效：模型从小到大弹跳出场
    if (withPop && mode3d && instance && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      instance.popIn();
    }
  }

  function mountAvatar() {
    const btn = document.getElementById('hero-mode-toggle');
    if (btn && !btn.dataset.modeInit) {
      btn.dataset.modeInit = '1';
      btn.addEventListener('click', () => {
        const going3d = !document.body.classList.contains('hero-3d-mode');
        applyMode(going3d, true); // 用户主动切换 → 带弹跳出场
      });
    }
    // 恢复上次选择（默认平面）
    let saved = 'flat';
    try { saved = localStorage.getItem(MODE_KEY) || 'flat'; } catch { /* 忽略 */ }
    applyMode(saved === '3d');
  }
  function unmountAvatar() {
    instance?.dispose();
    instance = null;
    delete (window as any).__ORIN_AVATAR__;
  }

  document.addEventListener('astro:page-load', mountAvatar);
  document.addEventListener('astro:before-swap', unmountAvatar);
  mountAvatar();
</script>
</section>
