---
// Hero 区：贴纸徽章 + 大标题荧光块 + 双 CTA + 插画卡片（对应设计稿 2:15）
const BASE_URL = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
---

<section class="hero">
  <div class="hero-left">
    <span class="hero-badge">AI 解决方案工程师 / FDE</span>
    <h1 class="hero-title">
      把 AI 真正<br />
      <span class="hero-title-marker">落地到业务里</span>
    </h1>
    <p class="hero-sub">
      从客户需求沟通、方案演示，到智能助手配置交付与使用辅导——我能独立跑通 AI 落地的完整链路。前端企业级项目开发出身，具备扎实的工程能力，从架构设计、数据流梳理到长期迭代维护都能独立扛住，正在补齐 RAG / Agent 评测闭环。
    </p>
    <div class="hero-cta-row">
      <a class="btn btn-primary" href="#works">
        看看我的作品
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 10H17M17 10L11 4M17 10L11 16" stroke="#FFDC58" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <a class="btn btn-secondary" href="#contact">聊聊 AI 落地</a>
    </div>
    <div class="hero-trust">
      <span class="trust-dot"></span>
      <span>2 个智能助手场景已交付 · 完整交付链路可独立闭环</span>
    </div>
  </div>

  <div class="hero-right">
    <div class="hero-image-card">
      <img src={`${BASE_URL}images/hero.png`} alt="开发者与 AI 机器人协作的新粗野主义插画" />
    </div>
    <div class="hero-status-badge">开放合作</div>
    <svg class="hero-sparkle" viewBox="0 0 44 44" fill="none" aria-hidden="true">
      <path d="M22 0L27 17L44 22L27 27L22 44L17 27L0 22L17 17L22 0Z" fill="#141414" />
    </svg>
  </div>
</section>
