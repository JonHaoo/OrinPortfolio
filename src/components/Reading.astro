---
// 阅读账本区：微信读书全量数据摘要，完整报告见 /reading/
import { AS_OF_SHORT, CATEGORY_DISTRIBUTION, READING_FACTS as F } from '../data/reading';
const BASE_URL = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

interface Stat {
  word: string;
  latin?: boolean;
  label: string;
  colorClass: string;
}

const stats: Stat[] = [
  { word: `${F.totalHours}h`, latin: true, label: '总阅读时长，约等于 53 个整天', colorClass: 'stat-yellow' },
  { word: `${F.booksRead}本`, label: `读过，其中完整读完 ${F.booksFinished} 本`, colorClass: 'stat-pink' },
  { word: `${F.notes}条`, label: '读书笔记，平均 7.6 条 / 本', colorClass: 'stat-blue' },
  { word: '21连胜', label: '21 天阅读挑战，达成 21 次', colorClass: 'stat-green' },
];
---

<section class="reading" id="reading">
  <div class="section-header">
    <span class="section-tag">READING DATA</span>
    <h2 class="section-title">我的阅读账本</h2>
    <p class="rd-asof">
      <span class="rd-asof-dot"></span>
      <span>数据快照 · 统计截至 <span class="rd-asof-date">{AS_OF_SHORT}</span> ／ 每天还在读，数字会持续更新</span>
    </p>
  </div>

  <div class="stats-row">
    {stats.map((s) => (
      <div class={`stat-block ${s.colorClass}`}>
        <span class={`stat-word${s.latin ? ' stat-latin' : ''}`}>{s.word}</span>
        <span class="stat-label">{s.label}</span>
      </div>
    ))}
  </div>

  <div class="rd-banner">
    <div class="rd-banner-left">
      <h3 class="rd-banner-title">这 {F.totalHours} 小时读了什么</h3>
      <span class="rd-banner-sub">按分类阅读时长 · 微信读书官方统计（2019–2026）</span>
      <div class="rd-bars">
        {CATEGORY_DISTRIBUTION.map((c) => (
          <div class="rd-bar-row">
            <span class="rd-bar-label">{c.name}</span>
            <span class="rd-bar-track"><span class="rd-bar" style={`--w:${c.width};--c:${c.color}`}></span></span>
            <span class="rd-bar-val">{c.hours}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="rd-banner-right">
      <p class="rd-persona">
        读什么，就是什么人——<span class="hl">{F.growthShare}</span> 的时长花在成长、心理与财经：
        一个把自己当产品迭代的读者；心理学读的是科班教材，AI 书单从 2025 年起一路读完。
      </p>
      <a class="rd-link-btn" href={`${BASE_URL}reading/`}>
        看完整阅读报告
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 10H17M17 10L11 4M17 10L11 16" stroke="#141414" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <span class="rd-link-hint">年度节奏 · 类型分布 · 读得最多 · 画像分析 · 勋章墙</span>
    </div>
  </div>
</section>
