---
// 阅读账本 —— 数字墙 + 联动条形图
// 2026-11-19 第五轮：与作品/能力区区分开，左侧四组巨大数字竖排（像仪表读数），
// 右侧是可按分类读数的条形图：指针移到某一条，其余淡出，顶部读数换成它的占比。
// 数据源：src/data/reading.ts（微信读书快照，统计截至 2026-11-13）。
import { AS_OF_SHORT, CATEGORY_DISTRIBUTION, READING_FACTS as F } from '../data/reading';
const BASE_URL = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

interface Figure {
  word: string;
  latin?: boolean;
  label: string;
  tone: string;
}

const figures: Figure[] = [
  { word: `${F.totalHours}h`, latin: true, label: '总阅读时长，约等于 53 个整天', tone: 'f1' },
  { word: `${F.booksRead}本`, label: `读过，其中完整读完 ${F.booksFinished} 本`, tone: 'f2' },
  { word: `${F.notes}条`, label: '读书笔记，平均 7.6 条 / 本', tone: 'f3' },
  { word: '21连胜', label: '21 天阅读挑战，达成 21 次', tone: 'f4' },
];
---

<section class="reading" id="reading">
  <div class="section-header">
    <span class="section-tag">READING DATA</span>
    <h2 class="section-title">我的阅读账本</h2>
    <p class="rd-asof">
      <span class="rd-asof-dot"></span>
      <span>数据快照 · 统计截至 <span class="rd-asof-date">{AS_OF_SHORT}</span> ／ 每天还在读</span>
    </p>
  </div>

  <div class="rd-board">
    <!-- 左：四组读数，竖排 -->
    <div class="rd-figures">
      {figures.map((f) => (
        <div class={`rd-figure rd-figure--${f.tone}`}>
          <span class={`rd-figure-word${f.latin ? ' is-latin' : ''}`}>{f.word}</span>
          <span class="rd-figure-label">{f.label}</span>
        </div>
      ))}
      <p class="rd-figures-note">数据来自微信读书官方统计（2019–2026），不是估算。</p>
    </div>

    <!-- 右：分类条形图，可悬停 / 键盘聚焦读数 -->
    <div class="rd-chart">
      <div class="rd-chart-head">
        <h3 class="rd-chart-title">这 {F.totalHours} 小时读了什么</h3>
        <span class="rd-chart-read" data-chart-read data-idle="把指针移到分类条上，看它占了多少">
          把指针移到分类条上，看它占了多少
        </span>
      </div>

      <ul class="rd-bars" data-bars>
        {CATEGORY_DISTRIBUTION.map((c) => (
          <li
            class="rd-bar-row"
            data-bar
            data-name={c.name}
            data-hours={c.hours}
            data-pct={c.pct}
            tabindex="0"
            aria-label={`${c.name}：${c.hours}，占总时长 ${c.pct}`}
          >
            <span class="rd-bar-label">{c.name}</span>
            <span class="rd-bar-track">
              <span class="rd-bar" style={`--w:${c.width};--c:${c.color}`}></span>
            </span>
            <span class="rd-bar-val">{c.hours}</span>
          </li>
        ))}
      </ul>

      <div class="rd-chart-foot">
        <p class="rd-persona">
          读什么，就是什么人——<span class="hl">{F.growthShare}</span> 的时长花在成长、心理与财经：
          一个把自己当产品迭代的读者；心理学读的是科班教材，AI 书单从 2025 年起一路读完。
        </p>
        <a class="rd-link-btn" href={`${BASE_URL}reading/`}>
          看完整阅读报告
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M3 10H17M17 10L11 4M17 10L11 16" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
