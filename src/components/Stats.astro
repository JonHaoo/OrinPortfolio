---
// 数据与信任：四个撞色数据块 + 两张客户评价卡（对应设计稿 2:137）
interface Stat {
  num: string;
  label: string;
  colorClass: string;
  small?: boolean;
}

const stats: Stat[] = [
  { num: '2年8个月', label: 'B 端项目交付经验', colorClass: 'stat-yellow', small: true },
  { num: '3', label: '类 B 端系统交付', colorClass: 'stat-pink' },
  { num: '2', label: '个智能助手场景已交付', colorClass: 'stat-blue' },
  { num: '5.7亿', label: '条评论 · 自研 Agent 数据规模', colorClass: 'stat-green', small: true },
];

interface Note {
  markClass: string;
  heading: string;
  content: string;
  source: string;
}

const notes: Note[] = [
  {
    markClass: 'mark-blue',
    heading: '交付不是终点，用起来才是',
    content: '招聘智能助手上线后，客户 HR 反馈「提问方式不符合预期」。我没有把它归为使用问题，而是回收成提示词迭代的输入——助手的最终形态，是在真实使用里长出来的。',
    source: '交付笔记 01 · 招聘智能助手',
  },
  {
    markClass: 'mark-pink',
    heading: '先划边界，再谈模型',
    content: '评论洞察 Agent 里，分类第一层用关键词规则、LLM 只做语义归因；招聘助手里，确定性内容走知识库、开放对话走 LLM。把算力花在只有模型能解决的地方，成本与准确率才都可控。',
    source: '交付笔记 02 · 架构取舍',
  },
];
---

<section class="stats" id="stats">
  <div class="section-header">
    <span class="section-tag">NUMBERS &amp; NOTES</span>
    <h2 class="section-title">用结果说话</h2>
  </div>

  <div class="stats-row">
    {stats.map((s) => (
      <div class={`stat-block ${s.colorClass}`}>
        <span class={`stat-num${s.small ? ' stat-num-sm' : ''}`}>{s.num}</span>
        <span class="stat-label">{s.label}</span>
      </div>
    ))}
  </div>

  <div class="quotes-row">
    {notes.map((t) => (
      <figure class="quote-card">
        <span class={`quote-mark ${t.markClass}`}>“</span>
        <blockquote>
          <h3 class="note-heading">{t.heading}</h3>
          <p class="quote-content">{t.content}</p>
        </blockquote>
        <figcaption class="quote-person">
          <span class="note-dot"></span>
          <span class="note-label">{t.source}</span>
        </figcaption>
      </figure>
    ))}
  </div>
</section>
