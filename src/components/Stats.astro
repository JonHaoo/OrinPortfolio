---
// 能力与方法 —— 巨型标号带（数字带点选 + 主从色块海报）
// 2026-11-21 第九轮：用户否决「能力罗盘」（细线 + 小方块 = 简陋），
// 从三种布局原型中选定 B。执行依据 NEO_BRUTAL_TOKENS：
//   3px 粗边框 / 8px 零模糊硬阴影 / 平面饱和色块 / 破格几何 / 巨大编号。
// 交互：点超大数字或 ← → / Home / End 切换，整块海报换色，证据面板滑入。
// 内容不变（真实做过的事）；隐私边界：无公司名/时间线/学校；理性陈述语气。
interface Capability {
  no: string;
  title: string;
  en: string;
  desc: string;
  evidence: string[];
  tags: string[];
}

const capabilities: Capability[] = [
  {
    no: '01',
    title: '交付落地',
    en: 'DEPLOYMENT',
    desc: '把系统从「可配置」带到「可用」：环境、权限、部署与培训，交付后对方能自己跑起来。',
    evidence: [
      '企业智能对话助手：配置、交付与使用培训',
      '公司官网：设计、开发与部署上线',
      '面向客户的讲解与技术支持',
    ],
    tags: ['交付', '部署', '培训'],
  },
  {
    no: '02',
    title: '系统集成',
    en: 'INTEGRATION',
    desc: '让系统与既有的数据、权限和流程对接，而不是另起一套并行逻辑。',
    evidence: [
      '数据源与流转路径梳理（Vue + ECharts）',
      '路由与操作层权限控制',
      'OSS + Docker 增量部署',
      '批量导入导出与号码解析',
    ],
    tags: ['API', '数据流转', 'Docker'],
  },
  {
    no: '03',
    title: '应用 AI',
    en: 'APPLIED AI',
    desc: '提示词、知识库与评测：让模型在具体业务里稳定工作，而不只是演示时可用。',
    evidence: [
      '提示词设计与按反馈迭代',
      '企业知识库配置（RAG 方向）',
      'AI 生图与品牌 GEO',
      '关注 LLM 评测与检索召回',
    ],
    tags: ['Prompt', 'RAG', 'LLM 评测'],
  },
  {
    no: '04',
    title: '双向转译',
    en: 'TRANSLATION',
    desc: '把业务问题拆成技术任务，也把系统能力讲成客户能操作的用法。',
    evidence: [
      '面向客户讲解与教学 AI 聚合系统',
      '售前演示与技术支持',
      '协调前端、设计与后端对齐实现',
    ],
    tags: ['客户沟通', '文档', '协作'],
  },
];

const methods = [
  { no: 'M1', title: '先定范围', desc: '从模糊诉求中界定可落地的环节与边界，范围清楚后再进入实现。' },
  { no: 'M2', title: '跑通再交', desc: '以完整可用链路作为交付标准，而不是一份功能清单。' },
  { no: 'M3', title: '写成可复用', desc: '把结论沉淀为开发规范与公共组件，减少口头约定。' },
  { no: 'M4', title: '双向对齐', desc: '与研发对齐实现细节，与业务对齐可用范围。' },
];

const evidenceCount = capabilities.reduce((n, c) => n + c.evidence.length, 0);
---

<section class="stats" id="stats">
  <div class="section-header">
    <span class="section-tag">CAPABILITIES</span>
    <h2 class="section-title">能力与方法</h2>
    <p class="section-sub">
      按 AI 交付类岗位的实际要求拆成四个能力面。点上方数字切换，每面只列做过的事。
    </p>
    <span class="section-meta">4 AREAS · {evidenceCount} 条证据</span>
  </div>

  <!-- 巨型标号带：四个超大描边数字，选中项填对应色 -->
  <div class="cap-belt" role="tablist" aria-label="能力面选择" data-cap-belt>
    {capabilities.map((c, i) => (
      <button
        type="button"
        class:list={['bl-tab', `bl-tab--${i + 1}`, { on: i === 0 }]}
        role="tab"
        id={`bl-tab-${i}`}
        aria-controls={`bl-panel-${i}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        data-bl-tab={i}
      >
        <span class="bl-num">{c.no}</span>
        <span class="bl-lbl">{c.en}</span>
        <span class="bl-nm">{c.title}</span>
      </button>
    ))}
  </div>

  <!-- 主从面板：左彩色海报 / 右白底证据，一次显示一项 -->
  <div class="cap-stage" data-cap-stage>
    {capabilities.map((c, i) => (
      <div
        class:list={['bl-panel', `bl-panel--${i + 1}`, { 'is-current': i === 0 }]}
        role="tabpanel"
        id={`bl-panel-${i}`}
        aria-labelledby={`bl-tab-${i}`}
        data-bl-panel={i}
        hidden={i !== 0}
      >
        <div class="bl-poster">
          <span class="bl-big" aria-hidden="true">{c.no}</span>
          <span class="bl-name">{c.title}</span>
          <span class="bl-en">{c.en}</span>
          <span class="bl-stamp" aria-hidden="true">{`0${i + 1}/04`}</span>
        </div>
        <div class="bl-body">
          <p class="bl-desc">{c.desc}</p>
          <span class="bl-label">做过的事 · {c.evidence.length} 条</span>
          <ul class="bl-ev">
            {c.evidence.map((e, k) => (
              <li style={`--ev-i: ${k}`}>{e}</li>
            ))}
          </ul>
          <ul class="bl-tags">
            {c.tags.map((t) => <li>{t}</li>)}
          </ul>
        </div>
      </div>
    ))}
  </div>

  <!-- 协作方法：循环流水线（四段 + 流动箭头） -->
  <div class="method-block">
    <div class="method-head">
      <h3 class="method-title">协作方法</h3>
      <span class="method-note">四条准则 · 不随项目变化</span>
    </div>
    <ol class="method-grid">
      {methods.map((m, i) => (
        <li class="method-item" style={`--flow-i: ${i}`}>
          <span class="method-no">{m.no}</span>
          <h4 class="method-name">{m.title}</h4>
          <p class="method-desc">{m.desc}</p>
          {i < methods.length - 1 && <span class="method-arrow" aria-hidden="true"></span>}
        </li>
      ))}
    </ol>
  </div>
</section>
