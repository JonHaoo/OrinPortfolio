---
// 能力标签区：四张撞色能力卡 + 两张交付笔记卡（对应设计稿 2:137）
interface Strength {
  word: string;
  latin?: boolean;
  label: string;
  colorClass: string;
}

const strengths: Strength[] = [
  { word: '0 → 1', latin: true, label: '企业级前端系统，从零搭到能用', colorClass: 'stat-yellow' },
  { word: '全链路', label: 'AI 落地五环节独立闭环，不甩锅', colorClass: 'stat-pink' },
  { word: '控幻觉', label: '分层边界设计，成本与准确率双可控', colorClass: 'stat-blue' },
  { word: '双向转译', label: '业务拆给 AI，技术讲给客户', colorClass: 'stat-green' },
];

interface Note {
  markClass: string;
  heading: string;
  content: string;
  source: string;
}

const notes: Note[] = [
  {
    markClass: 'mark-blue',
    heading: '交付不是终点，用起来才是',
    content: '招聘智能助手上线后，客户 HR 反馈「提问方式不符合预期」。我没有把它归为使用问题，而是回收成提示词迭代的输入——助手的最终形态，是在真实使用里长出来的。',
    source: '交付笔记 01 · 招聘智能助手',
  },
  {
    markClass: 'mark-pink',
    heading: '先划边界，再谈模型',
    content: '评论洞察 Agent 里，分类第一层用关键词规则、LLM 只做语义归因；招聘助手里，确定性内容走知识库、开放对话走 LLM。把算力花在只有模型能解决的地方，成本与准确率才都可控。',
    source: '交付笔记 02 · 架构取舍',
  },
];
---

<section class="stats" id="stats">
  <div class="section-header">
    <span class="section-tag">STRENGTHS &amp; NOTES</span>
    <h2 class="section-title">我的底气</h2>
  </div>

  <div class="stats-row">
    {strengths.map((s) => (
      <div class={`stat-block ${s.colorClass}`}>
        <span class={`stat-word${s.latin ? ' stat-latin' : ''}`}>{s.word}</span>
        <span class="stat-label">{s.label}</span>
      </div>
    ))}
  </div>

  <div class="quotes-row">
    {notes.map((t) => (
      <figure class="quote-card">
        <span class={`quote-mark ${t.markClass}`}>“</span>
        <blockquote>
          <h3 class="note-heading">{t.heading}</h3>
          <p class="quote-content">{t.content}</p>
        </blockquote>
        <figcaption class="quote-person">
          <span class="note-dot"></span>
          <span class="note-label">{t.source}</span>
        </figcaption>
      </figure>
    ))}
  </div>
</section>
