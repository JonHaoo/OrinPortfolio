---
// 工程方法论提炼卡：AI 辅助研发工作流规范的首页入口（链接到 /workflow/ 完整版）
const principles = [
  { color: 'wf-chip-yellow', text: '人负责方向与取舍' },
  { color: 'wf-chip-pink', text: 'AI 负责加速执行' },
  { color: 'wf-chip-blue', text: '测试提供证据，而非制造安全感' },
  { color: 'wf-chip-green', text: '流程强度与风险匹配' },
];
---

<section class="workflow-teaser" id="workflow">
  <div class="section-header">
    <span class="section-tag">METHODOLOGY</span>
    <h2 class="section-title">我的工程方法论</h2>
  </div>

  <div class="workflow-banner">
    <div class="wf-left">
      <div class="wf-head">
        <span class="wf-version">v1.0</span>
        <h3 class="wf-title">AI 辅助研发工作流规范</h3>
      </div>
      <p class="wf-desc">
        我自己沉淀并正在使用的一套流程：把「AI 写代码」变成「AI 在一条可验证的研发流程里干活」——按风险分快慢车道，小步实现，每个结论都要有证据，人保留产品判断和高风险决策权。
      </p>
      <div class="wf-chips">
        {principles.map((p) => <span class={`wf-chip ${p.color}`}>{p.text}</span>)}
      </div>
    </div>

    <div class="wf-right">
      <a class="btn wf-link-btn" href="/workflow/">
        读完整规范
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 10H17M17 10L11 4M17 10L11 16" stroke="#FFDC58" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <span class="wf-hint">0–17 共 18 个章节 · 档位 / 规格 / 测试 / 审查 / 复盘</span>
    </div>
  </div>
</section>
