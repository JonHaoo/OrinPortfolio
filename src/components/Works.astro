---
// 作品区：三张项目卡片（对应设计稿 2:42）
interface Project {
  num: string;
  type: string;
  title: string;
  desc: string;
  coverClass: string;
  chips: string[];
}

const projects: Project[] = [
  {
    num: '01',
    type: 'AI 交付案例',
    title: '招聘智能助手',
    desc: '从客户招聘流程拆出岗位解析、候选人问答、面试题生成三个环节；确定性内容走知识库、开放对话走 LLM，控制幻觉与答非所问。交付后辅导 HR 团队并迭代提示词。',
    coverClass: 'cover-blue',
    chips: ['Prompt 工程', '知识库配置'],
  },
  {
    num: '02',
    type: '个人项目 · 进行中',
    title: '跨境电商评论洞察 Agent',
    desc: '基于 Amazon Reviews 2023 公开数据集（5.7 亿条真实评论）构建评论管道 → RAG 检索 → 多步分析 Agent Loop → FAQ 衍生闭环；分类层用规则、LLM 只做语义归因以控成本。',
    coverClass: 'cover-pink',
    chips: ['RAG', 'Agent Loop', '评测体系'],
  },
  {
    num: '03',
    type: 'B 端工程案例',
    title: '投放数据分析系统',
    desc: '与运营、投放团队梳理数据源与流转，交付投放效果分析、市场竞品分析等可视化模块；同期负责广告投放 CRM、短剧版权交易平台等 B 端系统的前端架构与迭代。',
    coverClass: 'cover-green',
    chips: ['Vue', 'ECharts', 'TypeScript'],
  },
];
---

<section class="works" id="works">
  <div class="section-header">
    <span class="section-tag">SELECTED WORKS</span>
    <h2 class="section-title">精选作品</h2>
    <p class="section-sub">从客户侧的 AI 交付，到自研 Agent 的工程闭环，底层是 B 端系统的工程实现能力。</p>
  </div>

  <div class="cards-row">
    {projects.map((p) => (
      <article class="project-card">
        <div class={`project-cover ${p.coverClass}`}>
          <span class="num">{p.num}</span>
          <span class="type">{p.type}</span>
        </div>
        <div class="project-divider"></div>
        <div class="project-body">
          <h3 class="project-title">{p.title}</h3>
          <p class="project-desc">{p.desc}</p>
          <div class="project-chips">
            {p.chips.map((c) => <span class="chip">{c}</span>)}
          </div>
          <a class="project-link" href="#" aria-label={`查看项目：${p.title}`}>
            查看项目
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M3 9H15M15 9L10 4M15 9L10 14" stroke="#141414" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </article>
    ))}
  </div>
</section>
