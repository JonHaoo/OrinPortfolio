---
// 精选作品 —— 主从切换（左侧索引 / 右侧档案面板）
// 2026-11-19 第五轮：用户要求各模块用不同布局与交互，不要统一成一种规格表。
// 这里采用「档案馆」语言：左边是可点选的索引条目，右边是单张展开的档案页，
// 面板右上角压一个大号空心编号作为图形元素（不放色块）。
import { workCases } from '../data/works';

const BASE_URL = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<section class="works" id="works">
  <div class="section-header">
    <span class="section-tag">SELECTED WORKS</span>
    <h2 class="section-title">精选作品</h2>
    <p class="section-sub">
      三类项目分别对应交付落地、系统集成与业务侧应用。选中左侧一条看完整档案。
    </p>
    <span class="section-meta">03 ENTRIES · 点选切换</span>
  </div>

  <div class="wk-switch" data-works>
    <div class="wk-index" role="tablist" aria-label="项目索引" aria-orientation="vertical">
      {workCases.map((p, i) => (
        <button
          type="button"
          class:list={['wk-tab', { 'is-on': i === 0 }]}
          role="tab"
          id={`wk-tab-${i}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`wk-panel-${i}`}
          tabindex={i === 0 ? 0 : -1}
          data-wk-tab={i}
        >
          <span class="wk-tab-no">{p.num}</span>
          <span class="wk-tab-main">
            <span class="wk-tab-title">{p.title}{p.titleAccent}</span>
            <span class="wk-tab-type">{p.type}</span>
          </span>
          <span class="wk-tab-mark" aria-hidden="true"></span>
        </button>
      ))}
      <p class="wk-hint">↑ ↓ 键可切换 · 每条都是一个完整的决策记录</p>
    </div>

    <div class="wk-panels">
      {workCases.map((p, i) => (
        <article
          class:list={['wk-panel', { 'is-in': i === 0 }]}
          role="tabpanel"
          id={`wk-panel-${i}`}
          aria-labelledby={`wk-tab-${i}`}
          data-wk-panel={i}
          hidden={i !== 0}
        >
          <span class="wk-ghost" aria-hidden="true">{p.num}</span>

          <div class="wk-panel-top">
            <span class="wk-panel-case">CASE {p.num}</span>
            <span class="wk-panel-type">{p.type}</span>
          </div>

          <h3 class="wk-panel-title">
            {p.title}<span class="wk-panel-accent">{p.titleAccent}</span>
          </h3>

          <p class="wk-panel-lead">{p.lead}</p>

          <ul class="wk-panel-chips">
            {p.chips.map((c) => <li>{c}</li>)}
          </ul>

          <div class="wk-panel-foot">
            <a class="wk-panel-link" href={`${BASE_URL}works/${p.slug}/`}>
              打开过程档案
              <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path
                  d="M3 10H17M17 10L11 4M17 10L11 16"
                  stroke="currentColor"
                  stroke-width="2.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
            <span class="wk-panel-note">问题背景 / 关键决策 / 方法细节 / 反思</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
