---
// 作品区：两张横向大卡（01 客户侧 AI 交付 / 02 企业级前端工程）
// 布局：彩色封面块 + 竖分隔线 + 正文横向展开；偶数卡封面翻到右侧，形成 zigzag 节奏
interface Project {
  num: string;
  type: string;
  title: string;
  desc: string;
  coverClass: string;
  chips: string[];
}

const projects: Project[] = [
  {
    num: '01',
    type: 'AI 交付案例',
    title: '招聘智能助手',
    desc: '从客户招聘流程拆出岗位解析、候选人问答、面试题生成三个环节；确定性内容走知识库、开放对话走 LLM，控制幻觉与答非所问。交付后驻场辅导 HR 团队，把真实反馈回收成提示词迭代。',
    coverClass: 'cover-blue',
    chips: ['Prompt 工程', '知识库配置', '交付辅导'],
  },
  {
    num: '02',
    type: '企业级前端案例',
    title: '投放数据分析系统',
    desc: '与运营、投放团队梳理数据源与流转，交付投放效果分析、市场竞品分析等可视化模块；同期负责广告投放 CRM、短剧版权交易平台等企业级系统的前端架构与长期迭代。',
    coverClass: 'cover-green',
    chips: ['Vue', 'ECharts', 'TypeScript'],
  },
];
---

<section class="works" id="works">
  <div class="section-header">
    <span class="section-tag">SELECTED WORKS</span>
    <h2 class="section-title">精选作品</h2>
    <p class="section-sub">一条线把 AI 交付给客户，一条线把企业级系统做稳——都从需求谈到落地，全程可闭环。</p>
  </div>

  <div class="cards-row">
    {projects.map((p) => (
      <article class="project-card">
        <div class={`project-cover ${p.coverClass}`}>
          <span class="num">{p.num}</span>
          <span class="type">{p.type}</span>
        </div>
        <div class="project-divider"></div>
        <div class="project-body">
          <h3 class="project-title">{p.title}</h3>
          <p class="project-desc">{p.desc}</p>
          <div class="project-chips">
            {p.chips.map((c) => <span class="chip">{c}</span>)}
          </div>
          <a class="project-link" href="#contact" aria-label={`聊聊这个项目：${p.title}`}>
            聊聊这个项目
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M3 9H15M15 9L10 4M15 9L10 14" stroke="#141414" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </article>
    ))}
  </div>
</section>
