---
import Layout from '../layouts/Layout.astro';
import SiteRail from '../components/SiteRail.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Works from '../components/Works.astro';
import About from '../components/About.astro';
import Stats from '../components/Stats.astro';
import Reading from '../components/Reading.astro';
import WorkflowTeaser from '../components/WorkflowTeaser.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <SiteRail slot="rail" />
  <Hero />
  <Marquee />
  <About />
  <Works />
  <Stats />
  <Reading />
  <WorkflowTeaser />
  <Marquee
    tone="violet"
    text="PROMPT ENGINEERING ✳ KNOWLEDGE BASE ✳ RAG PIPELINE ✳ LLM EVAL ✳ AI WORKFLOW ✳ DELIVERY ✳ "
  />
  <Footer />
</Layout>
