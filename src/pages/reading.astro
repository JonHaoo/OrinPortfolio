---
/**
 * /reading/ — 阅读档案 READING ARCHIVE（编辑式数据叙事页）
 * 四个叙事阶段：01 THE NUMBERS 总账 → 02 THE JOURNEY 轨迹 → 03 THE MIND 心智 → 04 THE PERSON 人。
 * 数据：src/data/weread.json（微信读书 Agent API 真实快照，统计截至见数据文件）。
 * 动效与交互：src/scripts/reading-motion.ts（Lenis + GSAP ScrollTrigger，渐进增强）。
 */
import Layout from '../layouts/Layout.astro';
import { WEREAD as W } from '../data/reading';
import Masthead from '../components/reading/Masthead.astro';
import StageHead from '../components/reading/StageHead.astro';
import YearBars from '../components/reading/YearBars.astro';
import MonthStrip from '../components/reading/MonthStrip.astro';
import DayHeatmap from '../components/reading/DayHeatmap.astro';
import HourProfile from '../components/reading/HourProfile.astro';
import CategoryBars from '../components/reading/CategoryBars.astro';
import AuthorBars from '../components/reading/AuthorBars.astro';
import PublisherBars from '../components/reading/PublisherBars.astro';
import RankList from '../components/reading/RankList.astro';
import SpineShelf from '../components/reading/SpineShelf.astro';
import BestsGrid from '../components/reading/BestsGrid.astro';
import MedalShelf from '../components/reading/MedalShelf.astro';
import Observations from '../components/reading/Observations.astro';

const BASE_URL = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

const stages = [
  { id: 's01', n: '01', label: '总账' },
  { id: 's02', n: '02', label: '轨迹' },
  { id: 's03', n: '03', label: '心智' },
  { id: 's04', n: '04', label: '人' },
  { id: 'colophon', n: '∎', label: '尾声' },
];
---

<Layout
  fluid
  title="阅读档案 · Orin"
  description={`微信读书八年数据的编辑式阅读档案：${W.totals.hours} 小时、${W.totals.booksRead} 本、${W.totals.notes} 条笔记。年度轨迹、2026 逐日热力图、类型版图、作者偏好，以及数字背后的人。`}
>
  <div class="rdx-root" data-reading-page>
    <header class="site-header doc-header">
      <a class="logo vt-logo" href={BASE_URL} aria-label="返回作品集首页">
        <div class="logo-square"><span>O</span></div>
        <span class="logo-name">ORIN.DEV</span>
      </a>

      <nav class="site-nav" aria-label="主导航">
        <a href={BASE_URL}>返回作品集</a>
        <a href={`${BASE_URL}reading/`} class="active">阅读档案</a>
        <a href={`${BASE_URL}workflow/`}>研发工作流</a>
        <a href={`${BASE_URL}design-sop/`}>设计 SOP</a>
      </nav>

      <div class="nav-right">
        <button
          class="theme-toggle vt-toggle"
          id="theme-toggle-btn"
          type="button"
          role="switch"
          aria-checked="false"
          aria-label="切换深色 / 浅色主题"
          title="切换深色 / 浅色主题"
        >
          <svg class="icon-sun" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <circle cx="7" cy="7" r="3" fill="#FFF5E6" />
            <path d="M7 0.5V2.5M7 11.5V13.5M0.5 7H2.5M11.5 7H13.5M2.4 2.4L3.8 3.8M10.2 10.2L11.6 11.6M11.6 2.4L10.2 3.8M3.8 10.2L2.4 11.6" stroke="#FFF5E6" stroke-width="1.2" stroke-linecap="round" />
          </svg>
          <svg class="icon-moon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M13 9C11.9 9.6 10.7 9.9 9.4 9.9C5.2 9.9 1.8 6.5 1.8 2.3C1.8 1.8 1.9 1.3 2 0.9C0.9 1.7 0.2 3 0.2 4.5C0.2 8.2 3.1 11.1 6.8 11.1C9.2 11.1 11.3 9.8 12.4 7.8L13 9Z" fill="#141414" />
          </svg>
          <span class="knob">
            <svg class="knob-sun" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" style="position:absolute;top:5px;left:5px;">
              <circle cx="7" cy="7" r="3" fill="#141414" />
              <path d="M7 0.5V2.5M7 11.5V13.5M0.5 7H2.5M11.5 7H13.5M2.4 2.4L3.8 3.8M10.2 10.2L11.6 11.6M11.6 2.4L10.2 3.8M3.8 10.2L2.4 11.6" stroke="#141414" stroke-width="1.2" stroke-linecap="round" />
            </svg>
            <svg class="knob-moon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" style="position:absolute;top:5px;left:5px;">
              <path d="M13 9C11.9 9.6 10.7 9.9 9.4 9.9C5.2 9.9 1.8 6.5 1.8 2.3C1.8 1.8 1.9 1.3 2 0.9C0.9 1.7 0.2 3 0.2 4.5C0.2 8.2 3.1 11.1 6.8 11.1C9.2 11.1 11.3 9.8 12.4 7.8L13 9Z" fill="#141414" />
            </svg>
          </span>
        </button>

        <a class="btn btn-cta vt-cta" href={`${BASE_URL}#contact`}>聊聊合作</a>
      </div>
    </header>

    <!-- 章节子导航：进度条 + 四阶段锚点（本页主导航不吸附，让位于它） -->
    <nav class="rdx-subnav" aria-label="档案章节导航">
      <div class="rdx-subnav-inner">
        <div class="rdx-chips">
          {stages.map((s) => (
            <a class="rdx-chip" href={`#${s.id}`} data-spy={s.id}>
              <span class="n">{s.n}</span>{s.label}
            </a>
          ))}
        </div>
        <span class="rdx-snap">SNAPSHOT <b>{W.asOf}</b></span>
      </div>
      <div class="rdx-progress" id="rdx-progress" aria-hidden="true"></div>
    </nav>

    <main class="rdx-page">
      <div class="rdx-wrap">
        <!-- ===== 01 THE NUMBERS ===== -->
        <section id="s01" data-stage="01">
          <Masthead />
        </section>

        <!-- ===== 02 THE JOURNEY ===== -->
        <section id="s02" data-stage="02" class="rdx-stage">
          <StageHead
            index="02"
            latin="THE JOURNEY"
            title="阅读轨迹"
            kicker="从 2019 年注册到 2026 年进行中：一条真实的八年曲线——觉醒、登顶、稳态，以及每一天、每个小时的刻度。"
          />

          <div class="rdx-block">
            <h3 class="blk-title">年度节奏<span class="blk-lat">YEAR BY YEAR</span></h3>
            <YearBars />
          </div>

          <div class="rdx-block">
            <h3 class="blk-title">2026 · 逐月<span class="blk-lat">MONTHLY</span></h3>
            <MonthStrip />
            <p class="blk-note">
              8–10 月明显加速（29.2 / 25.2 / 28.9 小时），日均一度接近 2024 年峰值水平；
              年初 1–2 月的低谷拖低了全年日均（同比 −25.3%）。12 月尚未到来，如实留空。
            </p>
          </div>

          <div class="rdx-block">
            <h3 class="blk-title">逐日热力图<span class="blk-lat">DAILY GRID</span></h3>
            <DayHeatmap />
            <p class="blk-note">
              微信读书仅提供 2026 年逐日数据——这张热力图全部为真实记录，
              其他年份不伪造。悬停任意格子可查看当日阅读时长。
            </p>
          </div>

          <div class="rdx-block">
            <h3 class="blk-title">一天中的阅读<span class="blk-lat">24-HOUR PROFILE</span></h3>
            <HourProfile />
          </div>
        </section>

        <!-- ===== 03 THE MIND ===== -->
        <section id="s03" data-stage="03" class="rdx-stage">
          <StageHead
            index="03"
            latin="THE MIND"
            title="阅读的心智版图"
            kicker="读什么、反复读谁、在哪类书上停留最久——分类版图、作者偏好与时长榜单，全部可交互。"
          />

          <div class="rdx-block">
            <h3 class="blk-title">类型分布 · 总体 vs 2026<span class="blk-lat">CATEGORIES</span></h3>
            <CategoryBars />
          </div>

          <div class="rdx-prefs">
            <div class="rdx-block blk-authors">
              <h3 class="blk-title">作者偏好<span class="blk-lat">AUTHORS</span></h3>
              <AuthorBars />
              <p class="blk-note">
                认准了就读完：赫拉利 3 本 30.7h，清崎 / 梁永安 / 史铁生 / 余华各 4 本——
                合计涉猎 277 位作者，这是时长前十。
              </p>
            </div>
            <div class="rdx-block blk-pubs">
              <h3 class="blk-title">出版社偏好<span class="blk-lat">PUBLISHERS</span></h3>
              <PublisherBars />
              <p class="blk-note">
                中信 36 本、机工 23 本、北京联合 16 本——主流商业成长系出版社，
                与分类结构完全一致。
              </p>
            </div>
          </div>

          <div class="rdx-block">
            <h3 class="blk-title">读得最多<span class="blk-lat">LONGEST READS</span></h3>
            <RankList />
          </div>
        </section>

        <!-- ===== 04 THE PERSON ===== -->
        <section id="s04" data-stage="04" class="rdx-stage">
          <StageHead
            index="04"
            latin="THE PERSON"
            title="数字背后的人"
            kicker="档案的最后，把镜头转向人：可证明的事实、可讨论的推断，与一段自述——三层分开标注。"
          />

          <div class="rdx-block">
            <Observations />
          </div>

          <div class="rdx-block">
            <h3 class="blk-title">最近读完<span class="blk-lat">RECENTLY FINISHED</span></h3>
            <SpineShelf />
          </div>

          <div class="rdx-block">
            <h3 class="blk-title">读书之最<span class="blk-lat">THE BESTS</span></h3>
            <BestsGrid />
            <p class="blk-note">
              微信读书官方颁发的 12 个「读书之最」标签——
              其中「第一本阅读」是《HTML5+CSS3 网站设计基础教程》：这份档案始于一本前端教程。
            </p>
          </div>

          <div class="rdx-block">
            <h3 class="blk-title">勋章墙<span class="blk-lat">MEDALS</span></h3>
            <MedalShelf />
          </div>
        </section>

        <!-- ===== COLOPHON 尾声 ===== -->
        <section id="colophon" data-stage="colophon" class="rdx-colophon">
          <div class="cl-head">
            <span class="cl-lat">COLOPHON</span>
            <h2 class="cl-title">档案说明</h2>
          </div>
          <dl class="cl-list">
            <div><dt>数据来源</dt><dd>微信读书 Agent API（/shelf/sync + /readdata/detail overall + annually 2026），由 weread-data/export_site_data.py 加工为站点数据文件</dd></div>
            <div><dt>快照日期</dt><dd>{W.asOf}——每天仍在阅读，时长、书目与笔记持续变化；本页为该时点的静态快照</dd></div>
            <div><dt>已知缺失</dt><dd>逐年分类分布、2022–2025 逐日数据、按书笔记数、1 条已下架听书专辑的书名——缺失之处如实标注为空，不伪造</dd></div>
            <div><dt>口径备注</dt><dd>类型分布为官方时长权重；「最近读完」为书架在架标记口径；2026 为进行中年度，不与完整年度直接比较</dd></div>
            <div><dt>关于推断</dt><dd>画像分析基于数据模式的推断，非人格测评；阅读行为不等于能力或经历的证明</dd></div>
          </dl>
          <div class="cl-actions">
            <a class="btn wf-link-btn doc-back-btn" href={BASE_URL}>
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M17 10H3M3 10L9 4M3 10L9 16" stroke="#FFDC58" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              返回作品集
            </a>
            <span class="cl-end-note">READING ARCHIVE v2.0 · EDITORIAL DATA STORYTELLING · BUILT WITH ASTRO / GSAP / LENIS</span>
          </div>
        </section>
      </div>
    </main>

    <div class="rdx-tip" id="rdx-tip" role="status" aria-hidden="true"></div>

    <button class="rdx-totop" id="rdx-totop" type="button" aria-label="回到档案顶部">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M10 16V4M4 10L10 4L16 10" stroke="#141414" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>
</Layout>

<script>
  import '../scripts/reading-motion';
</script>

<style>
  /* 本页主导航改为常规滚动，把吸附位让给章节子导航 */
  .rdx-root :global(.site-header.doc-header) { position: static; }

  .rdx-wrap {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 48px) 140px;
  }

  .rdx-stage { margin-top: clamp(96px, 12vw, 150px); }

  .rdx-block { margin-top: 46px; }

  .rdx-block:first-of-type { margin-top: 0; }

  .blk-title {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 20px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--ink);
    font-size: 20px;
    font-weight: 900;
    color: var(--ink);
    transition: color var(--dur-base) var(--ease-slide);
  }

  .blk-lat {
    font-family: var(--font-data);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--muted);
    transition: color var(--dur-base) var(--ease-slide);
  }

  .blk-note {
    margin: 16px 0 0;
    font-size: 13.5px;
    line-height: 1.8;
    font-weight: 500;
    color: var(--ink);
    opacity: 0.75;
    transition: color var(--dur-base) var(--ease-slide);
  }

  /* 作者 / 出版社：不对称双栏 */
  .rdx-prefs {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 56px;
  }

  /* ===== COLOPHON ===== */
  .rdx-colophon {
    margin-top: clamp(96px, 12vw, 150px);
    padding-top: 36px;
    border-top: 3px solid var(--ink);
  }

  .cl-head {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 26px;
  }

  .cl-lat {
    padding: 4px 10px;
    background: var(--ink);
    color: var(--on-ink);
    font-family: var(--font-data);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    transition: background-color var(--dur-base) var(--ease-slide),
                color var(--dur-base) var(--ease-slide);
  }

  .cl-title {
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 400;
    color: var(--ink);
    transition: color var(--dur-base) var(--ease-slide);
  }

  .cl-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    max-width: 860px;
  }

  .cl-list > div {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 18px;
    padding: 13px 0;
    border-bottom: 1.5px dashed var(--rd-line);
  }

  .cl-list dt {
    font-size: 13px;
    font-weight: 900;
    color: var(--ink);
    transition: color var(--dur-base) var(--ease-slide);
  }

  .cl-list dd {
    font-size: 13.5px;
    line-height: 1.75;
    font-weight: 500;
    color: var(--ink);
    opacity: 0.8;
    transition: color var(--dur-base) var(--ease-slide);
  }

  .cl-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 34px;
  }

  .cl-end-note {
    font-family: var(--font-data);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--muted);
    transition: color var(--dur-base) var(--ease-slide);
  }

  @media (max-width: 1023px) {
    .rdx-prefs { grid-template-columns: 1fr; gap: 40px; }
    .cl-list > div { grid-template-columns: 92px 1fr; }
  }
</style>
