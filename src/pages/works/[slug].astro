---
// 案例详情页 · /works/[slug]/
// 结构按 PAGE_BLUEPRINT §2.4「过程档案」四段固定顺序：
// 问题背景 → 关键决策 → 方法细节 → 反思。
// 内容全部来自 src/data/works.ts（改写自站内既有项目描述），不编造指标/链接/反馈。
import Layout from '../../layouts/Layout.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import { workCases } from '../../data/works';

export function getStaticPaths() {
  return workCases.map((c, i) => ({
    params: { slug: c.slug },
    props: { item: c, index: i },
  }));
}

const { item, index } = Astro.props;
const BASE_URL = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

const prev = workCases[(index - 1 + workCases.length) % workCases.length];
const next = workCases[(index + 1) % workCases.length];

const title = `${item.title}${item.titleAccent} · 过程档案 · Orin`;
const description = item.lead;
---

<Layout fluid title={title} description={description}>
  <header class="site-header doc-header">
    <a class="logo vt-logo" href={BASE_URL} aria-label="返回作品集首页">
      <div class="logo-square"><span>O</span></div>
      <span class="logo-name">ORIN.DEV</span>
    </a>

    <nav class="site-nav" aria-label="主导航">
      <a href={`${BASE_URL}#works`}>全部作品</a>
      <a href={`${BASE_URL}reading/`}>阅读</a>
      <a href={`${BASE_URL}workflow/`}>工作流</a>
      <a href={`${BASE_URL}prompts/`}>提示词库</a>
    </nav>

    <div class="nav-right">
      <ThemeToggle />
      <a class="btn btn-cta vt-cta" href={`${BASE_URL}#contact`}>联系我</a>
    </div>
  </header>

  <div class="case-wrap">
    <a class="case-back" href={`${BASE_URL}#works`}>
      <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M17 10H3M3 10L9 4M3 10L9 16" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      全部作品
    </a>

    <!-- ===== 案例头 ===== -->
    <div class="case-hero">
      <div class="case-kicker">
        <span class="case-no">CASE {item.num}</span>
        <span class="case-type">{item.type}</span>
        <span class="case-kicker-line" aria-hidden="true"></span>
        <span class="case-kicker-en">PROCESS ARCHIVE</span>
      </div>

      <h1 class="case-title">
        {item.title}<br />
        <span class="case-hl">{item.titleAccent}</span>
      </h1>

      <p class="case-lead">{item.lead}</p>

      <dl class="case-meta">
        {item.meta.map((m) => (
          <div class="case-meta-item">
            <dt class="case-meta-label">{m.label}</dt>
            <dd class="case-meta-value">{m.value}</dd>
          </div>
        ))}
      </dl>

      <ul class="case-chips" aria-label="技术标签">
        {item.chips.map((c) => <li class="case-chip">{c}</li>)}
      </ul>
    </div>

    <!-- ===== 过程档案：四段固定顺序 ===== -->
    <div class="case-archive">
      {item.sections.map((s, i) => (
        <section class:list={['case-block', `case-block--${i + 1}`]}>
          <div class="case-block-head">
            <span class="case-block-no">{s.no}</span>
            <div class="case-block-titles">
              <h2 class="case-block-title">{s.title}</h2>
              <span class="case-block-en">{s.en}</span>
            </div>
          </div>

          {s.body.map((p) => <p class="case-block-p">{p}</p>)}

          {s.points && (
            <ul class="case-points">
              {s.points.map((pt) => <li>{pt}</li>)}
            </ul>
          )}
        </section>
      ))}
    </div>

    <!-- ===== 案例尾：前后导航 ===== -->
    <nav class="case-foot" aria-label="案例导航">
      <a class="case-nav case-nav--prev" href={`${BASE_URL}works/${prev.slug}/`}>
        <span class="case-nav-k">上一个</span>
        <span class="case-nav-v">{prev.title}{prev.titleAccent}</span>
      </a>
      <a class="case-nav case-nav--next" href={`${BASE_URL}works/${next.slug}/`}>
        <span class="case-nav-k">下一个</span>
        <span class="case-nav-v">{next.title}{next.titleAccent}</span>
      </a>
    </nav>

    <!-- 收尾联系条：联系方式为公开信息（NEO_BRUTAL_TOKENS §6） -->
    <section class="case-end">
      <p class="case-end-k">END OF CASE</p>
      <p class="case-end-t">想看更细的执行过程，或就类似项目交流，可以直接联系。</p>
      <div class="case-end-links">
        <a class="case-end-link" href="mailto:670243280@qq.com">670243280@qq.com</a>
        <a class="case-end-link" href="tel:19092408896">19092408896</a>
      </div>
    </section>
  </div>
</Layout>
